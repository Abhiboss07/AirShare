{
  "name": "air-share",
  "version": "0.1.0",
  "description": "Air Share — gesture-inspired local-network device transfer. Phase 1: secure discovery, pairing and messaging foundation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "air-share": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "vision:demo": "tsx scripts/vision-demo.ts",
    "transfer:demo": "tsx scripts/transfer-demo.ts",
    "mesh:demo": "tsx scripts/mesh-demo.ts",
    "content:demo": "tsx scripts/content-demo.ts"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
